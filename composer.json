{
    "name": "psc-acme/connector-order",
    "description": "Package connector-order for psc-acme organization",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Philipp Scheit",
            "email": "p.scheit@packagist.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "PscAcme\\ConnectorOrder\\": "src/"
        }
    },
    "require": {
        "php": ">=8.1",
        "firebase/php-jwt": "^6.0",
        "brick/math": "^0.12",
        "nesbot/carbon": "^2.72",
        "league/commonmark": "^2.0",
        "laravel/framework": "^11.0",
        "psc-acme/importer-invoice": "^1.0",
        "psc-acme/sanitizer-billing": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "stable",
    "config": {
        "secure-http": false
    },
    "repositories": {
        "private-packagist": {
            "type": "composer",
            "url": "http://repo.packagist.com.lo/psc-acme/"
        },
        "packagist.org": false
    }
}